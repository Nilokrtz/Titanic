generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model especializacoes {
  id                  Int                 @id @default(autoincrement())
  nome                tipo_especializacao @unique
  descricao           String?
  atributo_foco       tipo_topico_questao
  atributo_penalidade tipo_topico_questao
  personagens         personagens[]
}

model inventario_itens {
  id            Int          @id @default(autoincrement())
  personagem_id Int?
  item_id       Int?
  quantidade    Int?         @default(1)
  itens         itens?       @relation(fields: [item_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  personagens   personagens? @relation(fields: [personagem_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model itens {
  id               Int                @id @default(autoincrement())
  nome             String             @db.VarChar(100)
  descricao        String?
  tipo_efeito      String?            @db.VarChar(40)
  valor_efeito     Int?
  preco_moedas     Int
  inventario_itens inventario_itens[]
}

model perfis {
  id                Int                 @id @default(autoincrement())
  nome              tipo_perfil         @unique
  descricao         String?             @db.VarChar(200)
  perfis_permissoes perfis_permissoes[]
  usuarios          usuarios[]
}

model perfis_permissoes {
  perfil_id    Int
  permissao_id Int
  perfis       perfis     @relation(fields: [perfil_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  permissoes   permissoes @relation(fields: [permissao_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([perfil_id, permissao_id])
}

model permissoes {
  id                Int                 @id @default(autoincrement())
  slug              String              @unique @db.VarChar(100)
  descricao         String?             @db.VarChar(200)
  perfis_permissoes perfis_permissoes[]
}

model personagens {
  id                Int                @id @default(autoincrement())
  usuario_id        Int?               @unique
  especializacao_id Int?
  rank_id           Int?
  nome              String             @unique @db.VarChar(80)
  xp_atual          Int?               @default(0)
  vida_maxima       Int?               @default(100)
  vida_atual        Int?               @default(100)
  moedas            Int?               @default(0)
  inventario_itens  inventario_itens[]
  especializacoes   especializacoes?   @relation(fields: [especializacao_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  ranks             ranks?             @relation(fields: [rank_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  usuarios          usuarios?          @relation(fields: [usuario_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  tentativas_sala   tentativas_sala[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model quiz_questoes {
  id               Int                 @id @default(autoincrement())
  sala_id          Int?
  topico_atributo  tipo_topico_questao
  enunciado        String
  opcao_a          String              @db.VarChar(255)
  opcao_b          String              @db.VarChar(255)
  opcao_c          String              @db.VarChar(255)
  opcao_d          String              @db.VarChar(255)
  resposta_correta String?             @db.Char(1)
  dica_texto       String?
  salas_desafio    salas_desafio?      @relation(fields: [sala_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  tentativas_sala  tentativas_sala[]
}

model ranks {
  id            Int             @id @default(autoincrement())
  nome          String          @unique @db.VarChar(50)
  nivel_acesso  Int             @unique
  xp_minimo     Int
  personagens   personagens[]
  salas_desafio salas_desafio[]
}

model salas_desafio {
  id                Int               @id @default(autoincrement())
  rank_minimo_id    Int?
  numero_sala       Int               @unique
  nome              String            @db.VarChar(100)
  chefe_nome        String?           @db.VarChar(80)
  materia_foco      String?           @db.VarChar(100)
  xp_recompensa     Int
  moedas_recompensa Int
  dano_base_erro    Int
  quiz_questoes     quiz_questoes[]
  ranks             ranks?            @relation(fields: [rank_minimo_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  tentativas_sala   tentativas_sala[]
}

model tentativas_sala {
  id               Int                    @id @default(autoincrement())
  sala_id          Int?
  personagem_id    Int?
  questao_atual_id Int?
  status           tipo_status_tentativa? @default(EM_ANDAMENTO)
  vida_restante    Int
  acertos          Int?                   @default(0)
  erros            Int?                   @default(0)
  pulos_restantes  Int?                   @default(1)
  iniciado_em      DateTime?              @default(now()) @db.Timestamp(6)
  finalizado_em    DateTime?              @db.Timestamp(6)
  personagens      personagens?           @relation(fields: [personagem_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  quiz_questoes    quiz_questoes?         @relation(fields: [questao_atual_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  salas_desafio    salas_desafio?         @relation(fields: [sala_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model usuarios {
  id                 Int          @id @default(autoincrement())
  email              String       @unique @db.VarChar(150)
  senha              String       @db.VarChar(255)
  refresh_token_hash String?      @db.VarChar(255)
  perfil_id          Int?
  criado_em          DateTime?    @default(now()) @db.Timestamp(6)
  excluido_em        DateTime?    @db.Timestamp(6)
  personagens        personagens?
  perfis             perfis?      @relation(fields: [perfil_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

enum tipo_especializacao {
  ia
  seguranca
  dados
  front_end
  back_end
}

enum tipo_perfil {
  ADMIN_PROFESSOR
  MONITOR
  ALUNO
}

enum tipo_status_tentativa {
  EM_ANDAMENTO
  VITORIA
  DERROTA
}

enum tipo_topico_questao {
  ia
  seguranca
  dados
  front_end
  back_end
  logica
}

model conquistas {
id            Int   @id @default(autoincrement())
nome       String   @unique @db.VarChar(50)
descricao  String?  @db.VarChar(200)
recompensa   Int    @default(0)
}

model cassino {
  id                 Int     @id @default(autoincrement())
  nome               String  @db.VarChar(50)
  tipo_recompensa    String  @db.VarChar(20) 
  valor_recompensa   Int     @default(0)     
  chance_porcentagem Int                     
  descricao          String? @db.VarChar(200)
}