{
  "uid": "api-rpg",
  "title": "API RPG Acadêmico",
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 2,
  "refresh": "5s",
  "time": { "from": "now-30m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "GET /",
      "gridPos": { "h": 5, "w": 8, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum(http_requests_total{method=\"GET\",route=\"/\"}) or vector(0)", "instant": true }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "GET /personagens/:id",
      "gridPos": { "h": 5, "w": 8, "x": 8, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum(http_requests_total{method=\"GET\",route=\"/personagens/:id\"}) or vector(0)", "instant": true }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "POST /auth/login",
      "gridPos": { "h": 5, "w": 8, "x": 16, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum(http_requests_total{method=\"POST\",route=\"/auth/login\"}) or vector(0)", "instant": true }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "POST /auth/registrar",
      "gridPos": { "h": 5, "w": 12, "x": 0, "y": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum(http_requests_total{method=\"POST\",route=\"/auth/registrar\"}) or vector(0)", "instant": true }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "POST /personagens",
      "gridPos": { "h": 5, "w": 12, "x": 12, "y": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum(http_requests_total{method=\"POST\",route=\"/personagens\"}) or vector(0)", "instant": true }
      ]
    },
    {
      "id": 6,
      "type": "bargauge",
      "title": "Chamadas por rota",
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 10 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum by (method, route) (http_requests_total)", "legendFormat": "{{method}} {{route}}", "instant": true }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Chamadas por status HTTP",
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 10 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum by (status_code) (http_requests_total)", "legendFormat": "HTTP {{status_code}}" }
      ]
    }
  ]
}
